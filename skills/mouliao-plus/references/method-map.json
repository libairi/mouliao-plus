{
  "note": "领域为可重复的检索线索，不是互斥分类。方法适用性取决于具体问题。",
  "methods": [
    {
      "id": "M01",
      "name": "先调查，再下判断",
      "path": "methods/investigate.md",
      "when": "描述笼统、争议很大，或建议依赖未经核实的事实。",
      "domains": [
        "人生选择",
        "商业判断",
        "内容经营",
        "工作关系"
      ]
    },
    {
      "id": "M02",
      "name": "重新检查问题和目标",
      "path": "methods/reframe.md",
      "when": "用户把某个方案当成唯一出路，或解决了表面问题仍没有改善。",
      "domains": [
        "人生选择",
        "商业判断",
        "内容创作",
        "工作规划"
      ]
    },
    {
      "id": "M03",
      "name": "找出当前最影响结果的约束",
      "path": "methods/key-tension.md",
      "when": "问题很多、资源有限，需要判断先解决什么。",
      "domains": [
        "人生选择",
        "商业判断",
        "内容经营",
        "团队工作"
      ]
    },
    {
      "id": "M04",
      "name": "让行动检验判断",
      "path": "methods/experiment.md",
      "when": "争论无法靠现有资料解决，但存在成本可承受的试验。",
      "domains": [
        "人生选择",
        "商业验证",
        "内容试验",
        "工作方法"
      ]
    },
    {
      "id": "M05",
      "name": "把个人取舍和时间尺度讲清楚",
      "path": "methods/tradeoffs.md",
      "when": "不同选项都合理，却各自牺牲不同的生活、时间或资源。",
      "domains": [
        "人生选择",
        "职业选择",
        "商业判断",
        "内容规划"
      ]
    },
    {
      "id": "M06",
      "name": "检查长期积累是否正在发生",
      "path": "methods/long-term.md",
      "when": "用户在频繁换方向与长期坚持之间犹豫。",
      "domains": [
        "人生选择",
        "能力学习",
        "商业合作",
        "内容品牌"
      ]
    },
    {
      "id": "M07",
      "name": "把行动缩到可以开始",
      "path": "methods/start-small.md",
      "when": "用户知道大致目标，却迟迟不能开始或总在准备。",
      "domains": [
        "个人行动",
        "内容生产",
        "项目推进",
        "工作安排"
      ]
    },
    {
      "id": "M08",
      "name": "检查口头目标和实际激励",
      "path": "methods/incentives.md",
      "when": "行为与承诺、制度或公开目标不一致，需要理解相关方。",
      "domains": [
        "工作关系",
        "团队管理",
        "商业合作",
        "内容协作"
      ]
    },
    {
      "id": "M09",
      "name": "从对方的具体情境看价值",
      "path": "methods/value-context.md",
      "when": "自认为有用的产品、内容或提案没有得到期待回应。",
      "domains": [
        "商业判断",
        "内容表达",
        "工作提案",
        "职业能力"
      ]
    },
    {
      "id": "M10",
      "name": "检查做法与资源条件是否匹配",
      "path": "methods/resource-fit.md",
      "when": "模仿成功案例却无法执行，或现有组织很难支持新尝试。",
      "domains": [
        "商业判断",
        "工作安排",
        "内容项目",
        "个人规划"
      ]
    }
  ]
}
